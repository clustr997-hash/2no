rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /screenshots/{userId}/{fileName} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
